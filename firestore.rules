rules_version = '2';
service cloud.firestore {
  match /databases/{database}/documents {

    // =========================
    // 使用者自己的資料（完全私有）
    // =========================
    match /users/{userId}/{document=**} {
      allow read, write: if request.auth != null
                          && request.auth.uid == userId;
    }

    // =========================
    // 藥物成分字典（所有登入者可讀）
    // =========================
    match /drug_dictionary/{docId} {
      allow read: if request.auth != null;
      allow write: if false; // ❌ 用戶不能改字典
    }

    // =========================
    // 回饋與建議
    // =========================
    match /feedback/{docId} {
      allow create: if request.auth != null; // 任何登入者可寫
      allow read: if false;                  // 不讓用戶互看
    }

    // =========================
    // 社群看板申請與看板
    // =========================
    match /community_room_requests/{requestId} {
      // 社群功能尚未開放。UI 隱藏不是安全邊界，因此先完全封鎖。
      allow read, write: if false;
    }

    match /community_rooms/{roomId} {
      // 社群功能尚未開放。之後啟用時必須改成伺服器端角色驗證。
      allow read, write: if false;
    }

    // RevenueCat webhook/Admin SDK 維護的可信訂閱狀態。
    match /server_entitlements/{userId} {
      allow read, write: if false;
    }

    // AI usage and cost records are written only by the Admin SDK in Functions.
    match /ai_usage_events/{eventId} {
      allow read, write: if false;
    }

    // Daily AI summaries are also server-only operational billing data.
    match /ai_usage_daily/{dateId} {
      allow read, write: if false;
    }

    // Per-user abuse-prevention counters are maintained only by Functions.
    match /ai_rate_limits/{userId} {
      allow read, write: if false;
    }

    // Project-wide AI abuse-prevention counters are server-only.
    match /ai_global_rate_limits/{documentId} {
      allow read, write: if false;
    }

    // =========================
    // 其他所有路徑：預設全部拒絕
    // =========================
    match /{document=**} {
      allow read, write: if false;
    }
  }
}
