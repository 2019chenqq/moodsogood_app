rules_version = '2';
service cloud.firestore {
  match /databases/{database}/documents {

    // Public follow-up shares are created, validated, and revoked only by
    // trusted Firebase Functions. Clients never read the snapshots directly.
    match /follow_up_summary_shares/{shareId} {
      allow read, write: if false;
    }

    // =========================
    // 使用者自己的資料（完全私有）
    // =========================
    match /users/{userId}/{document=**} {
      allow read, write: if request.auth != null
                          && request.auth.uid == userId;
    }

    // =========================
    // 藥物成分字典（所有登入者可讀）
    // =========================
    match /drug_dictionary/{docId} {
      allow read: if request.auth != null;
      allow write: if false; // ❌ 用戶不能改字典
    }

    // =========================
    // 回饋與建議
    // =========================
    match /feedback/{docId} {
      allow create: if request.auth != null; // 任何登入者可寫
      allow read: if false;                  // 不讓用戶互看
    }

    // =========================
    // 社群看板申請與看板
    // =========================
    match /community_room_requests/{requestId} {
      // 登入者可建立申請
      allow create: if request.auth != null;

      // 所有登入者可讀取所有申請（UI 層級檢查誰能審核）
      allow read: if request.auth != null;

      // 申請者可更新自己的申請
      allow update: if request.auth != null
                    && resource.data.requesterUid == request.auth.uid;

      allow delete: if false;
    }

    match /community_rooms/{roomId} {
      // 登入者可讀取看板
      allow read: if request.auth != null;

      // 登入者可建立看板
      allow create: if request.auth != null;

      // 允許所有登入者嘗試刪除（UI 級別和 Firestore 級別檢查）
      allow delete: if request.auth != null;
      
      allow update: if false;
    }

    // AI usage and cost records are written only by the Admin SDK in Functions.
    match /ai_usage_events/{eventId} {
      allow read, write: if false;
    }

    // Daily AI summaries are also server-only operational billing data.
    match /ai_usage_daily/{dateId} {
      allow read, write: if false;
    }

    // Per-user abuse-prevention counters are maintained only by Functions.
    match /ai_rate_limits/{userId} {
      allow read, write: if false;
    }

    // =========================
    // 其他所有路徑：預設全部拒絕
    // =========================
    match /{document=**} {
      allow read, write: if false;
    }
  }
}
