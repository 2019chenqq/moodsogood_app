rules_version = '2';

service firebase.storage {
  match /b/{bucket}/o {
    function isOwner(userId) {
      return request.auth != null && request.auth.uid == userId;
    }

    function isValidJpeg(maxBytes) {
      return request.resource.size > 0
          && request.resource.size <= maxBytes
          && request.resource.contentType == 'image/jpeg';
    }

    function isValidEncryptedDiaryImage(fileName) {
      return fileName.matches('^[A-Za-z0-9_-]{24}[.]innera$')
          && request.resource.size > 0
          && request.resource.size <= 26 * 1024 * 1024
          && request.resource.contentType == 'application/octet-stream'
          && 'clientEncrypted' in request.resource.metadata
          && request.resource.metadata.clientEncrypted == 'true'
          && 'encryption' in request.resource.metadata
          && request.resource.metadata.encryption == 'AES-256-GCM'
          && 'formatVersion' in request.resource.metadata
          && request.resource.metadata.formatVersion == '1';
    }

    function isValidAiChatImage() {
      return request.resource.size > 0
          && request.resource.size <= 5 * 1024 * 1024
          && request.resource.contentType.matches('image/(jpeg|png|webp)')
          && 'purpose' in request.resource.metadata
          && request.resource.metadata.purpose == 'innera-ai-chat';
    }

    function isValidEncryptedAiChatImage(fileName) {
      return fileName.matches('^[A-Za-z0-9_-]{24}[.]innera$')
          && request.resource.size > 0
          && request.resource.size <= 6 * 1024 * 1024
          && request.resource.contentType == 'application/octet-stream'
          && 'purpose' in request.resource.metadata
          && request.resource.metadata.purpose == 'innera-ai-chat-permanent'
          && 'clientEncrypted' in request.resource.metadata
          && request.resource.metadata.clientEncrypted == 'true'
          && 'encryption' in request.resource.metadata
          && request.resource.metadata.encryption == 'AES-256-GCM'
          && 'formatVersion' in request.resource.metadata
          && request.resource.metadata.formatVersion == '1'
          && 'originalContentType' in request.resource.metadata
          && request.resource.metadata.originalContentType.matches(
            'image/(jpeg|png|webp)'
          );
    }

    function isValidTemporaryAiChatImage() {
      return request.resource.size > 0
          && request.resource.size <= 5 * 1024 * 1024
          && request.resource.contentType.matches('image/(jpeg|png|webp)')
          && 'purpose' in request.resource.metadata
          && request.resource.metadata.purpose == 'innera-ai-chat-temporary'
          && 'expiresAt' in request.resource.metadata;
    }

    // Current encrypted diary images plus legacy images awaiting migration.
    // Legacy paths are read/delete-only; new uploads must use the .innera format.
    match /users/{userId}/diary_images/{allPaths=**} {
      allow get, delete: if isOwner(userId);
    }

    match /users/{userId}/diary_images/{fileName} {
      allow create: if isOwner(userId)
          && isValidEncryptedDiaryImage(fileName);
      allow update: if false;
    }

    // Profile images are compressed by the app before upload.
    match /user_photos/{userId}/profile.jpg {
      allow get, delete: if isOwner(userId);
      allow create, update: if isOwner(userId)
          && isValidJpeg(5 * 1024 * 1024);
    }

    match /user_avatars/{fileName} {
      allow get, delete: if request.auth != null
          && fileName == request.auth.uid + '.jpg';
      allow create, update: if request.auth != null
          && fileName == request.auth.uid + '.jpg'
          && isValidJpeg(5 * 1024 * 1024);
    }

    match /users/{userId}/ai_chat_images/{allPaths=**} {
      allow get, delete: if isOwner(userId);
      allow create, update: if false;
    }

    match /users/{userId}/ai_chat_images_encrypted/{dateKey}/{fileName} {
      allow get, delete: if isOwner(userId);
      allow create: if isOwner(userId)
          && isValidEncryptedAiChatImage(fileName);
      allow update: if false;
    }

    match /ai_chat_temp/{userId}/{dateKey}/{fileName} {
      allow get, delete: if isOwner(userId);
      allow create: if isOwner(userId) && isValidTemporaryAiChatImage();
      allow update: if false;
    }

    match /{allPaths=**} {
      allow read, write: if false;
    }
  }
}
